# SkyRecon Development Environment Variables
# Copy this to .env and customize for your environment

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://skyrecon_user:skyrecon_pass@db:5432/skyrecon_db
POSTGRES_USER=skyrecon_user
POSTGRES_PASSWORD=skyrecon_pass
POSTGRES_DB=skyrecon_db

# ============================================
# Django Configuration
# ============================================
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,0.0.0.0
DJANGO_SETTINGS_MODULE=skyrecon_backend.settings

# ============================================
# JWT Authentication
# ============================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=300
JWT_REFRESH_EXPIRATION_DELTA=86400

# ============================================
# RabbitMQ / Channels Configuration
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CHANNEL_LAYERS_HOST=rabbitmq

# ============================================
# MQTT Broker Configuration
# ============================================
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_BROKER_KEEPALIVE=60

# ============================================
# Inference Service Configuration
# ============================================
YOLO_INFERENCE_URL=http://inference-mock:8001
INFERENCE_TIMEOUT=30

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_MAPBOX_TOKEN=

# ============================================
# Redis Cache (Optional)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# Data Retention & Archives
# ============================================
DETECTION_RETENTION_DAYS=30
TELEMETRY_RETENTION_DAYS=7

# ============================================
# Hazard Scoring Configuration
# ============================================
HAZARD_METAL_WEIGHT=1.0
HAZARD_PLASTIC_WEIGHT=0.7
HAZARD_ORGANIC_WEIGHT=0.5
HAZARD_LOW_THRESHOLD=0.3
HAZARD_MEDIUM_THRESHOLD=0.7
HAZARD_RUNWAY_PROXIMITY_MULTIPLIER=1.5

# ============================================
# Security
# ============================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ============================================
# Application Features (Feature Flags)
# ============================================
ENABLE_REAL_YOLO=False
ENABLE_RL_NAVIGATION=True
ENABLE_HEATMAP=True
MAX_CONCURRENT_DRONES=10
